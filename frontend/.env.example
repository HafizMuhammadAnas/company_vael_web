# Optional: override API base URL for the admin API client. Defaults to "/api/v1"
# (proxied to the backend in local development).
# VITE_API_BASE_URL=http://localhost:8000/api/v1

# Optional: override API base URL for public lead forms (contact / consultation /
# request-proposal). Defaults to same-origin "/api/v1" via the Vite proxy.
# Keep this aligned with VITE_API_BASE_URL when the frontend is hosted separately
# from the API.
# VITE_API_URL=http://localhost:8000/api/v1

# Public site URL — used at build time for SSG canonical links, sitemap.xml, and Open Graph.
# VITE_SITE_URL=https://vaelkode.com
